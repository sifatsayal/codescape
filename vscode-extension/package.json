{
  "name": "codebase-visualizer",
  "displayName": "Codebase Visualizer",
  "description": "Visualize codebase structure, dependencies, and architectural patterns",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onCommand:codebaseVisualizer.visualize",
    "onCommand:codebaseVisualizer.visualizeEmbedded"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codebaseVisualizer.visualize",
        "title": "Visualize Codebase",
        "category": "Codebase Visualizer"
      },
      {
        "command": "codebaseVisualizer.visualizeEmbedded",
        "title": "Visualize Codebase (Embedded)",
        "category": "Codebase Visualizer"
      }
    ],
    "configuration": {
      "title": "Codebase Visualizer",
      "properties": {
        "codebaseVisualizer.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to python executable used to run the codebase visualizer."
        },
        "codebaseVisualizer.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open browser when visualization is ready"
        },
        "codebaseVisualizer.visualizerRepoPath": {
          "type": "string",
          "default": "",
          "description": "Path to the visualizer repo (win26-Team22) if not pip-installed. Leave empty if you ran 'pip install -e .' from that repo."
        },
        "codebaseVisualizer.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key for AI-powered features (e.g. hover file summaries). Passed to the visualizer as OPENAI_API_KEY. Leave empty to use the OPENAI_API_KEY environment variable if set."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {},
  "publisher": "win26-team22",
  "repository": {
    "type": "git",
    "url": "https://github.com/StanfordCS194/win26-Team22"
  },
  "license": "MIT",
  "keywords": [
    "visualization",
    "dependencies",
    "codebase",
    "graph",
    "architecture"
  ]
}